<header class="site-header">
  <div class="site-container site-header__inner">
    <a class="site-brand" href="/" aria-label="PAGE KIT 홈">
      <span class="site-brand__symbol" aria-hidden="true">p.</span>
      <span>{{ site.name }}</span>
    </a>
    <div class="mobile-nav-controls" data-nav-controls hidden>
      <span>{{ title }}</span>
      <button class="btn btn--secondary" type="button" data-nav-toggle aria-expanded="false" aria-controls="site-navigation">전체 메뉴</button>
    </div>
    <nav class="site-nav" id="site-navigation" aria-label="주 메뉴">
      <ul class="site-nav__list">
        {% for item in site.navigation %}
        <li>
          <a class="site-nav__link" href="{{ item.href }}"{% if current == item.key %} aria-current="page"{% endif %}>{{ item.label }}</a>
        </li>
        {% endfor %}
      </ul>
    </nav>
    <span class="site-header__label">PUBLISHING STARTER <span aria-hidden="true">↗</span></span>
  </div>
</header>
