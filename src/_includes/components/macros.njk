{% macro button(label, href="", variant="primary", size="md", disabled=false) %}
  {% if href %}
  <a class="btn btn--{{ variant }} btn--{{ size }}" href="{{ href }}">{{ label }}</a>
  {% else %}
  <button class="btn btn--{{ variant }} btn--{{ size }}" type="button"{% if disabled %} disabled{% endif %}>{{ label }}</button>
  {% endif %}
{% endmacro %}

{% macro card(number, title, body, href, linkLabel) %}
<article class="card">
  <span class="card__number" aria-hidden="true">{{ number }}</span>
  <h3 class="card__title">{{ title }}</h3>
  <p class="card__description">{{ body }}</p>
  <a class="card__link" href="{{ href }}">{{ linkLabel }} <span aria-hidden="true">↗</span></a>
</article>
{% endmacro %}

{% macro field(id, label, placeholder="", help="", type="text", required=false, error="", value="", autocomplete="") %}
<div class="form-field">
  <label class="form-field__label" for="{{ id }}">{{ label }}{% if required %} <span class="form-field__required">(필수)</span>{% endif %}</label>
  <input class="form-field__input" id="{{ id }}" name="{{ id }}" type="{{ type }}" placeholder="{{ placeholder }}" value="{{ value }}" data-validate-field data-error-id="{{ id }}-error"{% if autocomplete %} autocomplete="{{ autocomplete }}"{% endif %}{% if required %} required{% endif %}{% if error %} aria-invalid="true"{% endif %}{% if help or error %} aria-describedby="{% if help %}{{ id }}-help{% endif %}{% if help and error %} {% endif %}{% if error %}{{ id }}-error{% endif %}"{% endif %}>
  {% if help %}<p class="form-field__help" id="{{ id }}-help">{{ help }}</p>{% endif %}
  <p class="form-field__error" id="{{ id }}-error"{% if not error %} hidden{% endif %}>{{ error }}</p>
</div>
{% endmacro %}
